# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_sport
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
LOG_LEVEL=info

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=5010                   # Puerto en el que se ejecutará el servidor
HOST=localhost              # Host/dirección IP del servidor (localhost, 0.0.0.0, etc.)
NODE_ENV=development        # Entorno de ejecución (development, production, test)

# ============================================
# CONFIGURACIÓN DE AUTENTICACIÓN JWT
# ============================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production  # Clave secreta para firmar tokens JWT (¡CAMBIAR EN PRODUCCIÓN!)
JWT_EXPIRES=24h             # Expiración del token del módulo administrador (24h, 7d, 30m, etc.)
JWT_EXPIRES_BOOKING=365d    # Expiración del token del portal de reservas (clientes) — sesión de larga duración a propósito

# ============================================
# USUARIO SYSTEM (SEED) — bootstrap del sistema nuevo
# ============================================
SYSTEM_SEED_EMAIL=system@gmail.com
SYSTEM_SEED_PASSWORD=

# ============================================
# CONFIGURACIÓN DE CORS
# ============================================
FRONTEND_URL=http://localhost:5173  # URL del frontend para configurar CORS correctamente
CORS_ORIGIN=http://localhost:5173,http://localhost:4173   # Orígenes permitidos para requests CORS (separados por comas)}
FRONT_ADMIN_BOOKING=https://localhost:3000
FRONT_BOOKING_APP=http://localhost:5173

# ============================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# ============================================
REDIS_ENABLED=false  # Habilitar/deshabilitar Redis (true/false)
REDIS_URL=redis://localhost:6379  # URL de conexión a Redis
REDIS_TTL=3600  # Tiempo de vida de los datos en caché (segundos)

# ============================================
# MONITOREO DE ERRORES — SENTRY (OPCIONAL)
# ============================================
# Obtener DSN en: https://sentry.io → Project Settings → Client Keys
# Si no se define SENTRY_DSN, Sentry se deshabilita automáticamente
SENTRY_DSN=  # https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# CONFIGURACIÓN DE CORREO — RESEND
# ============================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Remitente — en desarrollo usa onboarding@resend.dev (no requiere dominio propio)
# En producción usa un dominio verificado: Booking Sport <noreply@tudominio.com>
MAIL_FROM=Booking Sport <onboarding@resend.dev>

# ============================================
# PASARELAS DE PAGO (MERCADO PAGO - PERÚ)
# ============================================
# Obtener en: https://www.mercadopago.com.pe/developers/es/docs/credentials
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret
# Cuenta de prueba (Comprador) usada como payer_email en desarrollo — MercadoPago sandbox
# rechaza cualquier email real. Solo se usa si NODE_ENV=development. Nunca en producción.
MP_TEST_PAYER_EMAIL=test_user_xxxxxxxxxxxxxxxxxxx@testuser.com

# Clave para encriptar (AES-256-GCM) los access_token de MP que cada empresa/
# sucursal conecte a futuro (dsg_bss_mercadopago_credential). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MP_CREDENTIALS_ENCRYPTION_KEY=tu_clave_de_64_caracteres_hex

# ============================================
# CONFIGURACIÓN DE WHATSAPP — TWILIO
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+17372508034

# API externa de consulta de DNI (Perú) — usada al registrar un invitado
DNI_LOOKUP_API_URL=https://www.dsgperutech.com/api-customer/v1/dni